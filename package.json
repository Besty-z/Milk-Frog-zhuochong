{
  "name": "milk-frogs-beast-bond-sutra",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows desktop pet built step by step with Electron, React, and TypeScript.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config vite.web.config.ts && node scripts/rename-web-html.mjs",
    "preview:web": "vite preview --config vite.web.config.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "gifuct-js": "^2.1.2",
    "onnxruntime-web": "^1.21.0-dev.20250206-d981b153d3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7"
  }
}
